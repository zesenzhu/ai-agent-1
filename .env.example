# 复制为 .env 后填写。任何 OpenAI 兼容端点都可以，见 docs/02-接入模型.md

# 必填：模型服务地址（不带 /chat/completions）
OPENAI_BASE_URL=https://api.deepseek.com/v1

# 必填：API Key。本地 Ollama 可填任意非空字符串
OPENAI_API_KEY=sk-xxxxxxxx

# 必填：模型名称
OPENAI_MODEL=deepseek-chat

# 可选：采样温度
AGENT_TEMPERATURE=0.3

# 可选：单轮最多工具调用轮数，超过后强制收尾
AGENT_MAX_STEPS=8

# 可选：历史消息保留条数（不含 system），过长时从最早的非 system 消息开始裁剪
AGENT_MAX_HISTORY=40

# 可选：文件工具的沙箱根目录，默认当前工作目录
AGENT_WORKSPACE=.

# 可选：会话文件路径，默认 .agent-session.json
AGENT_SESSION_FILE=.agent-session.json

# 可选：是否流式输出，true/false
AGENT_STREAM=true
